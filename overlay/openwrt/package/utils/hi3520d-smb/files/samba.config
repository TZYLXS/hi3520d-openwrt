config samba
	option name 'HI3520D'
	option workgroup 'WORKGROUP'
	option description 'Hi3520D SATA storage'
	option charset 'UTF-8'
	option interface 'lan'
	option homes '0'
	option smbuser 'smbuser'
	option smbpass 'hi3520d'

config sambashare
	option name 'sata1'
	option path '/mnt/sata1'
	option users 'smbuser'
	option read_only 'no'
	option guest_ok 'no'
	option create_mask '0664'
	option dir_mask '0775'
	option browseable 'yes'

config sambashare
	option name 'sata2'
	option path '/mnt/sata2'
	option users 'smbuser'
	option read_only 'no'
	option guest_ok 'no'
	option create_mask '0664'
	option dir_mask '0775'
	option browseable 'yes'
